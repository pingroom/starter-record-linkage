  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js run",
    "connect": "node src/cli.js connect",
    "inspect": "node src/cli.js inspect",
    "status": "node src/cli.js status",
    "report": "node src/cli.js report",
    "find-id": "node src/cli.js find",
    "recover": "node src/cli.js recover",
    "demo": "node src/demo.js",
