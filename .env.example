# Demo, tests, and plan need no credentials. Use connect, or set BOTH values.
# Partial/blank overrides fail; keep actual values private.
# PINGROOM_TOKEN=your-robot-credential
# PINGROOM_ROOM=ROOMCODE1234
# Paths are relative to this project: catalog.json, config.json,
# .pingroom/credentials.json, .linkage/state.json, .linkage/report.json
